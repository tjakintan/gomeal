version: "3.9"
services:
  backend:
    build: ./gomeal-server
    ports:
      - "3000:3000"
    environment: 
      DEV: ${DEV}
    depends_on:
      - ml
      - redis

  ml:
    build: ./gomeal-ml
    ports:
      - "6969:6969"
    depends_on:
      - redis

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"